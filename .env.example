APP_ENV=production
APP_URL=https://transcriber.example.com
APP_VERSION=1.0.0
TZ=Asia/Amman
LOG_LEVEL=INFO
COOKIE_SECURE=true
TRUSTED_HOSTS=transcriber.example.com

ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_THIS_STRONG_PASSWORD
SESSION_SECRET=GENERATE_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

POSTGRES_DB=youtube_transcriber
POSTGRES_USER=youtube_transcriber
POSTGRES_PASSWORD=CHANGE_THIS_DATABASE_PASSWORD
DATABASE_URL=postgresql+psycopg://youtube_transcriber:CHANGE_THIS_DATABASE_PASSWORD@postgres:5432/youtube_transcriber

DEEPGRAM_API_KEY_WORKER_1=
DEEPGRAM_API_KEY_WORKER_2=
DEEPGRAM_API_KEY_WORKER_3=
DEEPGRAM_API_KEY_WORKER_4=
DEEPGRAM_API_KEY_WORKER_5=

DEFAULT_LANGUAGE=ar
DEFAULT_DEEPGRAM_MODEL=whisper-large
SESSION_TTL_MINUTES=720
SESSION_IDLE_MINUTES=120
